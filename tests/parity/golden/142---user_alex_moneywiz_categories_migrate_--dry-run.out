 "facts": {
  "pag-equity": {
   "id": "pag-equity",
   "value": 0.065,
   "text": "Long-run planning assumption for a global all-equity mix: about 6.5% a year before fees. By region: Canadian stocks 6.3%, US stocks 6.4%, international developed stocks 6.6%, emerging-market stocks 7.5%. A mix like VEQT (about 46% US, 30% Canada, 18% international developed, 7% emerging, Sep 30 2026) blends to 6.5%. For projections of 10+ years, not a forecast for any one year.",
   "source": "https://www.fpcanada.ca/newsdetail/fp-canada--and-the-institute-of-financial-planning-jointly-publish-the-2026-projection-assumption-guidelines-for-financial-planners",
   "as_of": "2026-11-14",
   "review_by": "2027-04-30",
   "confidence": "verified"
  },
  "pag-fixed-income": {
   "id": "pag-fixed-income",
   "value": 0.032,
   "text": "Long-run planning assumption for bonds: 3.2% a year before fees.",
   "source": "https://www.fpcanada.ca/newsdetail/fp-canada--and-the-institute-of-financial-planning-jointly-publish-the-2026-projection-assumption-guidelines-for-financial-planners",
   "as_of": "2026-04-16",
   "review_by": "2027-04-30",
   "confidence": "verified"
  },
  "pag-short-term": {
   "id": "pag-short-term",
   "value": 0.024,
   "text": "Long-run planning assumption for cash and short-term deposits: 2.4% a year.",
   "source": "https://www.fpcanada.ca/newsdetail/fp-canada--and-the-institute-of-financial-planning-jointly-publish-the-2026-projection-assumption-guidelines-for-financial-planners",
   "as_of": "2026-04-16",
   "review_by": "2027-04-30",
   "confidence": "verified"
  },
  "pag-inflation": {
   "id": "pag-inflation",
   "value": 0.021,
   "text": "Long-run planning assumption for inflation: 2.1% a year.",
   "source": "https://www.fpcanada.ca/newsdetail/fp-canada--and-the-institute-of-financial-planning-jointly-publish-the-2026-projection-assumption-guidelines-for-financial-planners",
   "as_of": "2026-04-16",
   "review_by": "2027-04-30",
   "confidence": "verified"
  },
  "return-band": {
   "id": "return-band",
   "judgment": true,
   "value": 0.02,
   "text": "Width of the range around each return assumption: plus or minus 2 points a year. Nobody knows long-run returns; this wide band is a judgment call to keep ranges honest, not a sourced number.",
   "source": "https://www.fpcanada.ca/newsdetail/fp-canada--and-the-institute-of-financial-planning-jointly-publish-the-2026-projection-assumption-guidelines-for-financial-planners",
   "as_of": "2026-11-01",
   "review_by": "2027-04-30",
   "confidence": "heuristic"
  },
  "one-year-drop": {
   "id": "one-year-drop",
   "value": -0.42,
   "text": "Global stocks can fall about 40% in one calendar year: the MSCI ACWI lost about 42% (net, USD) in 2008. Money you need within a few years does not belong in stocks.",
   "source": "https://www.msci.com/documents/1296102/1636401/ACWI+factsheet/d5d4e6b0-3957-4938-a4aa-dbc956ae93af",
   "as_of": "2026-11-01",
   "review_by": "2027-04-30",
   "confidence": "estimate",
   "notes": "The 2008 figure is from memory of the factsheet's annual table; the factsheet page shown in a search did not include the 2008 row. Verify before quoting it."
  },
  "crypto-drawdown": {
   "id": "crypto-drawdown",
   "value": -0.7,
   "text": "Bitcoin has fallen 70% or more from a peak within about a year more than once (2018 and 2022). Crypto above your own cap can fall much further than stocks.",
   "source": "https://en.wikipedia.org/wiki/History_of_bitcoin",
   "as_of": "2026-11-09",
   "review_by": "2027-05-31",
   "confidence": "estimate",
   "notes": "Peak-to-trough falls of about 84% (Dec 2017 to Dec 2018) and about 77% (Nov 2021 to Nov 2022) from general price history; verify against an exchange price series before quoting exact figures."
  },
  "spiva-canada": {
   "id": "spiva-canada",
   "value": 0.988,
   "text": "98.8% of Canadian equity funds trailed their benchmark over 10 years to the end of 2025. Professional stock picking rarely beats the index after fees, so this tool does not pick stocks.",
   "source": "https://www.spglobal.com/spdji/en/spiva/article/spiva-canada-year-end-2025/",
   "as_of": "2026-03-31",
   "review_by": "2027-04-30",
   "confidence": "verified"
  },
