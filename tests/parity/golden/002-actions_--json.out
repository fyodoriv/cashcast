     "grant",
     "revoke"
    ],
    "required": true,
    "help": "",
    "default": null
   },
   {
    "name": "scope",
    "flag": null,
    "kind": "choice",
    "choices": [
     "agent:aggregates",
     "agent:raw-row",
     "agent:strategy",
     "cloud:sheets",
     "cloud:notion",
     "net:market-data",
     "net:usage-counts",
     "local:reminders",
     "local:calendar",
     "local:moneywiz",
     "actions:browser",
     "agent:browser-read",
     "actions:api"
    ],
    "required": false,
    "help": "",
    "default": null
   }
  ],
  "ui": true,
  "terminal_only": null,
  "terminal_only_choices": {
   "grant": "consent is typed into your own terminal, so no web page or agent can grant it"
  },
  "confirm": null,
  "confirm_choices": {
   "revoke": "turns off a consent you granted"
  },
  "agent_note": "agents: never grant; give the owner the `consent grant SCOPE` command to run in a terminal"
 },
