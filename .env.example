# Names only; real values go in private/users/<name>/.env (mode 600, never committed)
# or your shell. Every key is optional: each turns on one read-only API.
# CASHCAST_WISE_TOKEN=            # Wise personal API token (read-only)
# CASHCAST_KRAKEN_KEY=            # Kraken API key with Query + Export permissions only
# CASHCAST_KRAKEN_SECRET=
# CASHCAST_PAYPAL_CLIENT_ID=      # PayPal REST app (live), reporting scope
# CASHCAST_PAYPAL_SECRET=
# CASHCAST_ETRADE_KEY=            # E*TRADE consumer key; run: bin/cashcast api etrade-auth
# CASHCAST_ETRADE_SECRET=
# CASHCAST_GOOGLE_TOKEN=          # e.g. from: gcloud auth print-access-token
# CASHCAST_ALPHAVANTAGE_KEY=      # free market-data key (only ticker symbols are sent)
# CASHCAST_NOTION_TOKEN=          # your own Notion integration, shared with your tasks database only (decision 0009)
